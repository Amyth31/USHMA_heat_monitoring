# ---- Python / backend ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
venv/
.venv/
env/
*.env

# ---- Node / Next.js frontend ----
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/next-env.d.ts

# ---- Environment / secrets ----
# .env.example stays tracked (it's placeholder values); real .env files
# with actual passwords/passcodes never should be.
.env
.env.local
.env.*.local

# ---- Runtime-generated data caches (NOT the real source data) ----
# These are rebuilt automatically by the app at runtime — committing them
# just bloats the repo and can go stale/conflict across machines.
data/processed/alerts_store.json
data/processed/world_bank_cache.json
data/processed/weather_cache/

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
*.swp

# ---- Build artifacts ----
*.log
dist/
build/
