# USHMA backend configuration
PORT=5000
FLASK_DEBUG=true

# Weather provider (live = Open-Meteo, no API key needed, free tier)
WEATHER_PROVIDER=live

# CORS origin for frontend dev server
FRONTEND_ORIGIN=http://localhost:3000

# Optional: enables real PostgreSQL/PostGIS-backed reads instead of CSV/JSON.
# IMPORTANT: connect as ushma_app (see scripts/init_db.sql), never as the
# admin/owner role — Postgres Row-Level Security on the alerts table is a
# no-op for superusers and table owners.
# DATABASE_URL=postgresql://ushma_app:change_this_password_in_production@localhost:5432/ushma

# Shared passcode gating who can ISSUE or RESOLVE alerts (sent as the
# X-Authority-Key request header). Viewing alerts stays public. Change this
# in any real deployment — a shared passcode is a prototype-scoped stand-in
# for real per-user government accounts.
AUTHORITY_PASSCODE=ushma-authority-2026
